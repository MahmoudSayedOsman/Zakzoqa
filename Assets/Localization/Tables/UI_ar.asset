  - m_Id: 1241034755
    m_Localized: "\u0631\u062C\u0648\u0639"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034756
    m_Localized: "\u0643\u064A\u0633 \u0639\u0645\u0644\u0627\u062A \u0635\u063A\u064A\u0631"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034757
    m_Localized: "\u0635\u0646\u062F\u0648\u0642 \u0639\u0645\u0644\u0627\u062A"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034758
    m_Localized: "\u062E\u0632\u0646\u0629 \u0639\u0645\u0644\u0627\u062A"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034759
    m_Localized: "\u0645\u0636\u0627\u0639\u0650\u0641 \u0627\u0644\u0639\u0645\u0644\u0627\u062A:
      \u0639\u0645\u0644\u0627\u062A \u0643\u0644 \u0645\u0631\u062D\u0644\u0629
      \xD72 \u0644\u0644\u0623\u0628\u062F"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034760
    m_Localized: "\u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062A"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034761
    m_Localized: "\u0623\u0641\u0636\u0644 \u0642\u064A\u0645\u0629"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034762
    m_Localized: "\u0627\u0633\u062A\u0631\u062C\u0627\u0639 \u0627\u0644\u0645\u0634\u062A\u0631\u064A\u0627\u062A"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034763
    m_Localized: "\u0645\u062A\u062C\u0631 \u062A\u062C\u0631\u064A\u0628\u064A:
      \u0644\u0646 \u064A\u064F\u062E\u0635\u0645 \u0623\u064A \u0645\u0628\u0644\u063A."
    m_Metadata:
      m_Items: []
  - m_Id: 1241034764
    m_Localized: "\u0627\u0637\u0644\u0628 \u0645\u0646 \u0634\u062E\u0635 \u0643\u0628\u064A\u0631"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034765
    m_Localized: "\u0643\u0645 \u0646\u0627\u062A\u062C {0} \xD7 {1}\u061F"
    m_Metadata:
      m_Items: []
  - m_Id: 1241034766
    m_Localized: "\u0644\u064A\u0633\u062A \u0635\u062D\u064A\u062D\u0629. \u0625\u0644\u064A\u0643
      \u0633\u0624\u0627\u0644\u064B\u0627 \u062C\u062F\u064A\u062F\u064B\u0627."
    m_Metadata:
      m_Items: []
  - m_Id: 1241034767
    m_Localized: "\u0625\u0639\u0627\u062F\u0629 \u0627\u0644\u0628\u062F\u0621 \u062A\u0645\u0633\u062D
      \u0627\u0644\u0646\u062C\u0648\u0645 \u0648\u0627\u0644\u0639\u0645\u0644\u0627\u062A\u060C
      \u0648\u0645\u0646\u0647\u0627 \u0627\u0644\u0639\u0645\u0644\u0627\u062A \u0627\u0644\u062A\u064A
      \u0627\u0634\u062A\u0631\u064A\u062A\u0647\u0627. \u0623\u0645\u0627 \u0645\u0627
      \u0627\u0634\u062A\u0631\u064A\u062A\u0647 \u0644\u064A\u0628\u0642\u0649\u060C
      \u0645\u062B\u0644 \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0646\u0627\u062A\u060C
      \u0641\u064A\u0628\u0642\u0649."
    m_Metadata:
      m_Items: []
